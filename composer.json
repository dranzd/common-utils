{
    "name": "dranzd/common-utils",
    "description": "Framework-agnostic utility functions for PHP applications - Array, String, Date, Money, Object, and Search utilities",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "utilities",
        "helpers",
        "array",
        "string",
        "date",
        "money",
        "object",
        "search",
        "framework-agnostic",
        "php8.3"
    ],
    "authors": [
        {
            "name": "Dranzd",
            "email": "dranzd@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Dranzd\\Common\\Utils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dranzd\\Common\\Utils\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src tests --level=8",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    }
}
