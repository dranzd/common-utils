{
    "name": "dranzd/common-utils",
    "description": "Small, dependency-free PHP utilities: array key case conversion and merging, string case conversion, safe nested access, reflection helpers, date validation, money minor-unit conversion and SQL LIKE pattern building.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "utilities",
        "helpers",
        "array",
        "string",
        "case-conversion",
        "snake-case",
        "camel-case",
        "nested-access",
        "reflection",
        "framework-agnostic"
    ],
    "homepage": "https://github.com/dranzd/common-utils",
    "authors": [
        {
            "name": "Dranzd",
            "email": "dranzd@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dranzd/common-utils/issues",
        "source": "https://github.com/dranzd/common-utils"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dranzd\\Common\\Utils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dranzd\\Common\\Utils\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=build/clover.xml",
        "phpstan": "phpstan analyse --no-progress",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "test:coverage": "Run the test suite with a coverage report (needs pcov or xdebug)",
        "phpstan": "Run PHPStan static analysis",
        "cs-check": "Check coding standards (PSR-12)",
        "cs-fix": "Fix coding standards violations",
        "check": "Run every quality gate"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
